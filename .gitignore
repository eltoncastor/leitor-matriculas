# Python
__pycache__/
*.py[cod]
*.pyo

# Ambientes virtuais
.venv/
venv/
env/

# Testes / cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE
.vscode/
.idea/

# Sistema operacional
.DS_Store
Thumbs.db

# Arquivos temporários
*.tmp
*.temp

# Logs
*.log

# Resultados gerados
saida/*
!saida/.gitkeep

# Arquivos de teste locais
exemplos/
teste.jpg
teste - Copy.jpg
resultado_ocr.csv
estrutura.txt

# Entradas reais
entrada/*
!entrada/.gitkeep

# Dados reais
dados/*.xlsx

# Configuração local do Claude
.claude/settings.local.json

# Historico de correcoes humanas (Fase 20): contem matriculas, nomes de
# gestores e datas reais -- pelo mesmo motivo que os XLSX acima, nunca deve
# ser versionado. Nada no programa le este arquivo: apaga-lo devolve o
# sistema exatamente ao estado anterior a Fase 20.
dados/correcoes_humanas.jsonl

# Ferramentas locais baixadas sob demanda (Sub-fase 24b: Node.js portátil
# usado só para desenvolver o frontend web -- não é dependência do
# projeto em si, nem deve ser versionado).
.tools/

# Frontend web (Fase 24b) -- artefatos de build/dependências do Node, nunca
# versionados (mesma convenção de venv/ para Python).
web/frontend/node_modules/
web/frontend/dist/

# Preferencia de tema (Sub-fase 22e): estado local de UI, nao dado de
# negocio -- fica fora de dados/ de proposito (ver ui/preferencias.py).
# Nao versionado pelo mesmo motivo que qualquer outro estado por maquina.
preferencias_ui.json

# Empacotamento .exe (Sub-fase 25b): saída gerada pelo PyInstaller a partir
# de web/desktop_app.spec -- binário grande, reproduzível a qualquer momento
# rodando o build de novo (ver web/README.md), nunca deve ser versionado.
# O `.spec` em si FICA versionado (é a receita do build, não o resultado).
/build_exe/
/dist_exe/
