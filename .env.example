# .env.example -- Sub-fase 26c (OCR Worker distribuído).
#
# Copie para ".env" (na raiz do projeto) e preencha com valores reais.
# ".env" NUNCA é versionado (ver .gitignore) -- este arquivo de exemplo
# não contém nenhum segredo real, só o formato esperado.
#
# Lido por:
#   - worker/config.py (o processo Worker, tipicamente no PC Windows)
#   - web/backend/auth_worker.py (a VPS, só a variável LEITOR_WORKER_TOKEN)
#
# Uma variável de ambiente "de verdade" (definida antes de rodar, ex.
# `set OCR_WORKER_TOKEN=...` no PowerShell) sempre tem prioridade sobre o
# que estiver aqui.

# --- Usadas pelo Worker (worker/config.py) --------------------------------

# Endereço da VPS. Em produção, o IP Tailscale da VPS (ver CLAUDE.md,
# "Ajuste pontual pós-Fase 25 -- acesso remoto via Tailscale") -- nunca o
# domínio público (as rotas de Worker não existem sob /leitor de
# propósito, ver web/backend/main.py). Em teste local, 127.0.0.1.
API_BASE_URL=http://100.x.x.x:8000

# Identificador deste Worker -- aparece em log e no campo worker_id do
# Job, nunca decide autorização sozinho (quem decide é o token abaixo).
# Escolha algo que identifique a máquina (ex. o nome do PC).
OCR_WORKER_ID=pc-elton-worker1

# Segredo compartilhado entre o Worker e a VPS -- precisa ser IDÊNTICO ao
# LEITOR_WORKER_TOKEN configurado na VPS (ver abaixo). Pelo menos 16
# caracteres; gere algo aleatório, nunca uma frase óbvia.
OCR_WORKER_TOKEN=troque-por-um-segredo-aleatorio-de-verdade

# Segundos entre cada consulta a "há Job disponível?". Opcional.
POLL_INTERVAL=5

# Segundos entre cada batida de heartbeat -- precisa ficar bem abaixo do
# LEASE_S do servidor (120s, ver web/backend/estado.py) para sobrar folga
# antes do lease poder vencer. Opcional.
HEARTBEAT_INTERVAL=20

# --- Usada pela VPS (web/backend/auth_worker.py) --------------------------

# O MESMO valor de OCR_WORKER_TOKEN acima -- é o que a VPS compara contra
# o que cada Worker envia. Sem esta variável configurada no processo da
# VPS, TODA requisição de Worker é recusada (503) -- nunca aceita por
# padrão.
LEITOR_WORKER_TOKEN=troque-por-um-segredo-aleatorio-de-verdade

# Opcional -- ver web/backend/config.py e web/backend/armazenamento.py.
# LEITOR_MODO=servidor
# LEITOR_ARMAZENAMENTO=/caminho/persistente/na/vps/armazenamento
